# Field-level encryption key for sensitive values (phones, emails, notes).
# Generate one and store it as a Cloudflare/Sites secret named FIELD_KEY:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Base64-encoded 32 bytes (AES-256-GCM). Never commit the real value.
FIELD_KEY=

# WhatsApp interface (Meta WhatsApp Cloud API). Set these as Worker secrets:
#   WHATSAPP_TOKEN, WHATSAPP_PHONE_ID, WHATSAPP_VERIFY_TOKEN, WHATSAPP_APP_SECRET
# The webhook is /api/whatsapp/webhook and every call is checked against
# X-Hub-Signature-256 before it is parsed. Never commit the real values.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Local development only (wrangler.dev reads .dev.vars, not .env):
# FFP_DEV_PIN is used by scripts/smoke.mjs, default 135790.

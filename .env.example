# Copy to .env (or set each one as a Worker secret) and fill in. Names only -
# never commit a real value.

# Field-level encryption key for sensitive values (phones, emails, notes).
# Base64-encoded 32 bytes (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_KEY=

# Key that seals a Google refresh token before it is stored in D1.
# Base64url 32 bytes; rotating it invalidates existing drive connections.
BACKUP_KEY=

# Telegram alerts: one shared bot for every household.
#   TELEGRAM_BOT_TOKEN      from @BotFather (/newbot)
#   TELEGRAM_WEBHOOK_SECRET any random string; also sent to setWebhook as secret_token
#   TELEGRAM_CHAT_ID        ONLY for the owner's smoke test, never for delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_ID=

# Google sign-in and Drive backup. The client id is public and lives in
# wrangler.jsonc vars; only the secret is a secret.
GOOGLE_CLIENT_SECRET=

# Sign-in codes by email (Resend). MAIL_FROM is optional and lives in vars;
# without it Resend's onboarding sender is used, which only mails the account owner.
RESEND_API_KEY=
MAIL_FROM=

# Local development only (wrangler dev reads .dev.vars, not .env):
# FFP_DEV_PIN is used by scripts/smoke.mjs, default 135790.

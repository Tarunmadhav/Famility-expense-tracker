<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ reads this file for cloud backup and device-to-device transfer.
  Nothing in this app ships to either one: the WebView holds the session cookie and
  a cache of the family's financial records, and a restored copy would carry both to
  a new device (or into someone's Drive) without the PIN being asked for again.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

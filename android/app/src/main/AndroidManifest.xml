<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.family.planner">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Biometric unlock of the lock screen. Both names are declared because
         Android 9+ reads USE_BIOMETRIC and 8.x only knows USE_FINGERPRINT; neither
         is a runtime permission, and the app still works with a PIN if no
         credential is enrolled. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!-- Re-arms the 15-minute deadline check after a reboot: a setInexactRepeating
         alarm does not survive one, and reminders must still arrive the next day. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      allowBackup is off on purpose: the WebView keeps the session cookie and the
      cached planner data under the app's data directory, and Android's auto backup
      would copy both to the user's cloud account (and to adb). Same reasoning for
      fullBackupContent/dataExtractionRules, which govern Android 12+ device-to-device
      transfers and cloud backups separately from allowBackup.
    -->
    <application
        android:label="Family Planner"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Sign-in with Google/Facebook/Microsoft starts in the system browser and
              returns here with a one-time ticket. autoVerify makes Android hand this
              path to the app instead of the browser once the domain serves
              /.well-known/assetlinks.json with this build's signing certificate.
              Until that is configured the platform shows a chooser, which still works.

              The host is the deployment origin; move the Worker and this must change
              with it (android/gradle.properties plannerApiBaseUrl is the other half).
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="family-finance-planner.tarungudipatimadhav.workers.dev"
                    android:pathPrefix="/api/auth/oauth/finish" />
            </intent-filter>
        </activity>

        <!-- Deadline check while the app is closed. Both are internal: exported is
             true only for the boot one, which the system has to be able to deliver. -->
        <receiver
            android:name=".MainActivity$AlertReceiver"
            android:exported="false" />
        <receiver
            android:name=".MainActivity$BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

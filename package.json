{
  "name": "family-finance-planner",
  "private": true,
  "version": "2.6.0",
  "type": "module",
  "description": "Family Finance Planner - realtime web + Android app with analytics, notifications and a D1 database",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787 --local",
    "build": "node scripts/build.mjs",
    "preview": "npm run build && wrangler dev --port 8787 --local",
    "test": "node --test \"test/**/*.test.mjs\"",
    "db:seed": "node scripts/db-seed.mjs",
    "smoke": "node scripts/smoke.mjs",
    "security-test": "node scripts/security-test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "workerd@1.20261101.1": true
  }
}

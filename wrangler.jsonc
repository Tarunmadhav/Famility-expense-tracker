{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "family-finance-planner",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Public configuration. No secret belongs here: these values are visible in
  // every consent URL (the client id) and in the app-links file (the fingerprint).
  "vars": {
    // Android App Links. This is the DEBUG keystore fingerprint used by the local
    // emulator build; a release build signs with a different key and its SHA-256
    // must be added here before the app is published (see SECURITY.md).
    "ANDROID_SHA256": "95:21:80:E2:C9:6E:17:B1:40:C5:6B:5D:26:7E:E8:24:91:BC:11:DF:09:C5:76:EF:B0:C1:22:93:5A:B0:B6:2C,92:FB:42:CC:82:84:01:DD:20:21:20:68:03:DE:56:F8:A7:84:80:7F:F9:FC:B0:AC:16:77:BD:7C:F3:C7:12:D9",
    "GOOGLE_CLIENT_ID": "311970877046-vghniju6d2gi82sodd7dvjv2hcbk6v9h.apps.googleusercontent.com",
    // Public @username of the shared Telegram bot (no @). Settings links straight
    // to https://t.me/<this>, so people never have to search for the bot.
    "TELEGRAM_BOT_USERNAME": "FamilyFinancePlanner_bot",
    // Resend sender. onboarding@resend.dev is Resend's own test address: it only
    // delivers to the Resend account owner, so replace it with an address on a
    // verified domain before other family members sign in by email code.
    "MAIL_FROM": "onboarding@resend.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-planner",
      "database_id": "74d24b62-dbbc-4a8c-92d8-2e54fbb566df"
    }
  ],
  // Documents drive. The bucket exists on this account; uploads are validated by
  // content sniffing and every read is scoped to the caller's profile.
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "family-planner-drive"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Automatic backup (docs/BACKUP.md). The trigger exists so the feature can run;
  // whether an account is backed up is a per-account switch that defaults to off,
  // so this costs one scheduled invocation a day that usually does nothing.
  "triggers": {
    // Every quarter hour for task reminders (a task is reminded in the 15
    // minutes before it is due), plus the daily backup slot.
    "crons": ["*/15 * * * *", "17 2 * * *"]
  }
}
